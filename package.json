{
  "name": "@diwata/ironvale",
  "version": "0.0.1",
  "private": true,
  "description": "CSS component library for the Diwata Stack",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ironvale.css": "./dist/ironvale.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm && node scripts/build-css.mjs",
    "validate": "node scripts/validate-tokens.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "peerDependencies": {
    "@diwata/aether": "workspace:*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.3.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.10"
  }
}
